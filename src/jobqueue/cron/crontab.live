SHELL=/bin/bash
# Proposed speculoos crontab on appct once nightly processing goes through the queue (decisions Q3, Q4).
# Times are appct local time (Europe/London). The five nightly lines are kept, commented out, for rollback:
# to roll back, uncomment them and comment out the three queue lines (or reinstall the saved crontab).
#
# --- orchard job queue (live) ---
# keep one dispatcher running inside orchard-server; starts the container only if it is down
*/5 * * * * /appct/data/speculoos/orchard/src/jobqueue/cron/queue-cron.sh watchdog
# ESO watcher: queue each night's download and pipeline as soon as its frames are at ESO (Artemis: its raw directory)
*/30 11-23 * * * /appct/data/speculoos/orchard/src/jobqueue/cron/queue-cron.sh watch
# 30-night look-back: fetch late frames add-only, rerun nights that gained frames or have no light curves (P1)
15 21 * * * /appct/data/speculoos/orchard/src/jobqueue/cron/queue-cron.sh lookback
#
# --- replaced by the queue (rollback: uncomment) ---
#00 19 * * * source /home/speculoos/.bashrc; ulimit -u 2061801; docker-compose -f /appct/data/speculoos/orchard/docker/docker-compose.server.yml up -d; docker exec orchard-server bash -c "python download/SSO_download.py --dir /data/SPECULOOSPipeline --telescope Io --sdate $(date -d '-1 day'  +\%Y\%m\%d) --edate $(date -d 'today'  +\%Y\%m\%d) --max-retries 25" > "/appct/data/SPECULOOSPipeline/ESO_logs/$(date -d '-1 day'  +\%Y\%m\%d)Io.log" 2>&1 && docker exec orchard-server bash -c "./main/ZLP_pipeline.sh --force-platesolve 1 /data/SPECULOOSPipeline $(date -d '-1 day'  +\%Y\%m\%d) 8 2 Io"
#00 20 * * * source /home/speculoos/.bashrc; ulimit -u 2061801; docker-compose -f /appct/data/speculoos/orchard/docker/docker-compose.server.yml up -d; docker exec orchard-server bash -c "python download/SSO_download.py --dir /data/SPECULOOSPipeline --telescope Europa --sdate $(date -d '-1 day'  +\%Y\%m\%d) --edate $(date -d 'today'  +\%Y\%m\%d) --max-retries 25" > "/appct/data/SPECULOOSPipeline/ESO_logs/$(date -d '-1 day'  +\%Y\%m\%d)Europa.log" 2>&1 && docker exec orchard-server bash -c "./main/ZLP_pipeline.sh --force-platesolve 1 /data/SPECULOOSPipeline $(date -d '-1 day'  +\%Y\%m\%d) 8 2 Europa"
#00 21 * * * source /home/speculoos/.bashrc; ulimit -u 2061801; docker-compose -f /appct/data/speculoos/orchard/docker/docker-compose.server.yml up -d; docker exec orchard-server bash -c "python download/SSO_download.py --dir /data/SPECULOOSPipeline --telescope Ganymede --sdate $(date -d '-1 day'  +\%Y\%m\%d) --edate $(date -d 'today'  +\%Y\%m\%d) --max-retries 25" > "/appct/data/SPECULOOSPipeline/ESO_logs/$(date -d '-1 day'  +\%Y\%m\%d)Ganymede.log" 2>&1 && docker exec orchard-server bash -c "./main/ZLP_pipeline.sh --force-platesolve 1 /data/SPECULOOSPipeline $(date -d '-1 day'  +\%Y\%m\%d) 8 2 Ganymede"
#00 22 * * * source /home/speculoos/.bashrc; ulimit -u 2061801; docker-compose -f /appct/data/speculoos/orchard/docker/docker-compose.server.yml up -d; docker exec orchard-server bash -c "python download/SSO_download.py --dir /data/SPECULOOSPipeline --telescope Callisto --sdate $(date -d '-1 day'  +\%Y\%m\%d) --edate $(date -d 'today'  +\%Y\%m\%d) --max-retries 25" > "/appct/data/SPECULOOSPipeline/ESO_logs/$(date -d '-1 day'  +\%Y\%m\%d)Callisto.log" 2>&1 && docker exec orchard-server bash -c "./main/ZLP_pipeline.sh --force-platesolve 1 /data/SPECULOOSPipeline $(date -d '-1 day'  +\%Y\%m\%d) 8 2 Callisto"
#00 23 * * * source /home/speculoos/.bashrc; ulimit -u 2061801; docker-compose -f /appct/data/speculoos/orchard/docker/docker-compose.server.yml up -d; docker exec orchard-server bash -c "./main/ZLP_pipeline.sh 1 /data/SPECULOOSPipeline $(date -d '-1 day'  +\%Y\%m\%d) 8 2 Artemis"
#
# --- unchanged ---
00 06 * * * source /home/speculoos/.bashrc; ulimit -u 2061801; docker-compose -f /appct/data/speculoos/orchard/docker/docker-compose.server.yml up -d; docker exec orchard-server bash -c "python reporting/total_hours.py" > "/home/speculoos/total_hours.out"
00 05 * * * source /home/speculoos/.bashrc; ulimit -u 2061801; python2.7 /appct/data/SPECULOOSPipeline/Pipeline_v2/scripts/qualitychecks/completeness_check.py -f=completeness_check -d=/appct/data/SPECULOOSPipeline/ -v=v2
